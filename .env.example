# Public base URL mirroring the repo `data/` tree (country/city.json).
# Required on Vercel: data/** is excluded from the function bundle.
DATA_BASE_URL=

# Diyanet credentials — used only by scripts/fetch-*.mjs, never at request time.
# In CI these come from GitHub Actions secrets, not this file.
DIYANET_EMAIL=
DIYANET_PASS=
